{
  "name": "section-l-city-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{css,ts,vue}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{css,ts,vue}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.1"
  }
}
